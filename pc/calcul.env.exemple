# Copier en « .env » à côté de calcul.yml (dossier C:\millesime), puis compléter.

# Adresse de Millésime sur le NAS (réseau local ou Tailscale)
MILLESIME_URL=http://192.0.2.10:8098

# Jeton de calcul : même valeur que MILLESIME_JETON_CALCUL dans la stack homelab
MILLESIME_JETON_CALCUL=

# Version figée du modèle MiVOLO (empreinte d'un commit de iitolstykh/mivolo_v2 sur Hugging Face).
# Vide : la dernière version est chargée, avec un avertissement au journal du calculateur.
MIVOLO_REVISION=
