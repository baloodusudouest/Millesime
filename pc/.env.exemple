# Copier ce fichier en « .env » (même dossier que compose.yml) puis le compléter.

# Adresse d'Immich vue depuis le PC : IP du NAS + port d'Immich (variable PORT_IMMICH de la stack)
IMMICH_URL=http://192.168.1.10:2283

# Clé API Immich (Paramètres du compte › Clés API) — toutes permissions, à supprimer après le test
IMMICH_API_KEY=

# Modèle de vision local (Ollama). qwen3-vl:4b-instruct si la carte graphique a moins de 8 Go. Prendre une variante « instruct » : les autres réfléchissent longuement et la réponse peut rester vide
VLM_MODELE=qwen3-vl:8b-instruct

# Photos datées par la vision locale (la plus lente des méthodes)
MAX_PHOTOS_VLM=150

# 1 = refaire le test alors que data\resultats\rapport.md existe déjà
MILLESIME_TEST_FORCER=0
